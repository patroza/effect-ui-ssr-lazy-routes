{
  "name": "effect-ui-ssr-lazy-routes",
  "version": "0.0.0",
  "private": true,
  "description": "@effect/ui multi-page routing + SSR + zero-flash hydration + per-route Vite code splitting",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/serve.ts --outDir dist/server",
    "start": "node dist/server/serve.js",
    "typecheck": "node scripts/tsrs.mjs --noEmit",
    "lint": "node scripts/oxlint.mjs --type-aware .",
    "lint:fix": "node scripts/oxlint.mjs --type-aware --fix . && pnpm format",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "verify:bundles": "node scripts/verify-bundles.ts",
    "smoke": "node scripts/smoke.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm verify:bundles && pnpm test && pnpm smoke"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@7ef6234",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@7ef6234",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect-app/eslint-codegen-model": "2.0.1",
    "@effect-app/eslint-shared-config": "0.7.0",
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.73.7",
    "@effect/vitest": "4.1.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "25.9.1",
    "happy-dom": "21.0.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tailwindcss": "4.3.5",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "6.0.3",
    "vite": "8.0.15",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.17.0"
}
