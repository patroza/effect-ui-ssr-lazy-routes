{
  "name": "effect-ui-ssr-lazy-routes",
  "version": "0.0.0",
  "private": true,
  "description": "@effect/ui multi-page routing + SSR + zero-flash hydration + per-route Vite code splitting",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/serve.ts --outDir dist/server",
    "start": "node dist/server/serve.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@7ef6234",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@7ef6234",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "25.9.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.0.15",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.17.0"
}
