{
  "name": "effect-ui-ssr-lazy-routes",
  "version": "0.0.0",
  "private": true,
  "description": "@effect/ui multi-page routing + SSR + zero-flash hydration + per-route Vite code splitting",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vp run dev:server",
    "build": "vp run build:client && vp run build:server",
    "build:client": "vp build",
    "build:server": "vp build --ssr src/server/serve.ts --outDir dist/server",
    "start": "vp run start:server",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "effect-tsgo vp lint",
    "lint:fix": "vp run lint:autofix",
    "format": "vp run format:write",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "verify:bundles": "node scripts/verify-bundles.ts",
    "smoke": "node scripts/smoke.ts",
    "knip": "knip --no-progress",
    "check": "vp run format:check && vp run lint && vp run typecheck && vp run build:client && vp run build:server && vp run verify:bundles && vp run test && vp run smoke && vp run knip"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@f4cddd0",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@f4cddd0",
    "effect": "4.1.7"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.7",
    "@effect/tsgo": "0.74.1",
    "@effect/ui-devtools": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-devtools@f4cddd0",
    "@effect/vitest": "4.1.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.11",
    "happy-dom": "21.0.4",
    "knip": "^6.48.0",
    "tailwindcss": "4.3.5",
    "vite-plus": "1.8.0"
  },
  "packageManager": "pnpm@12.17.0"
}
