{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect-app/eslint-shared-config/src/oxlintrc.json",
    "./.agent-tooling/oxlint.strict.json"
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn", "node"],
  "rules": {
    "import/no-self-import": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag", "_etag"]
      }
    ],
    "typescript/no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": true,
        "variables": true
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/restrict-template-expressions": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-base-to-string": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": ".",
            "message": "Please import from the specific file instead. Imports from index in the same directory are almost always wrong (circular)."
          },
          {
            "name": "./",
            "message": "Please import from the specific file instead. Imports from index in the same directory are almost always wrong (circular)."
          },
          {
            "name": "./index",
            "message": "Please import from the specific file instead. Imports from index in the same directory are almost always wrong (circular)."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/*.css",
    "**/*.json",
    "**/*.md",
    "**/*.js",
    "**/*.jsx",
    "**/*.cjs",
    "**/coverage/**"
  ]
}
